# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais committer .env dans le dépôt.

# PostgreSQL
DB_NAME=sia_b2b
DB_USER=sia
DB_PASSWORD=CHANGER_CE_MOT_DE_PASSE

# Kafka
KAFKA_CLUSTER_ID=sia-b2b-cluster-01

# Redis
REDIS_PASSWORD=CHANGER_CE_MOT_DE_PASSE

# Email (SMTP)
MAIL_HOST=smtp.votre-fournisseur.tn
MAIL_PORT=587
MAIL_USERNAME=noreply@sia.tn
MAIL_PASSWORD=CHANGER_CE_MOT_DE_PASSE
MAIL_SMTP_AUTH=true
MAIL_SMTP_TLS=true

# Application
SIA_ADMIN_EMAIL=admin@sia.tn
APP_BASE_URL=https://b2b.sia.tn

# S3 / Cloudflare R2 (médias et sauvegardes)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=sia-b2b-media
S3_ACCESS_KEY=CHANGER_CE_MOT_DE_PASSE
S3_SECRET_KEY=CHANGER_CE_MOT_DE_PASSE
S3_REGION=auto
